{
	admin off
	# 用 80 端口做 HTTP-01 验证；HTTPS 对外端口是 HTTPS_PORT（默认 14443）
	http_port 80
	https_port {$HTTPS_PORT}
	# 浏览器按 IP 访问时不发 SNI，需指定默认证书，否则 TLS 握手失败
	default_sni {$PUBLIC_HOST}
}

# 公网 IP 的正式证书：Let's Encrypt 只在 shortlived 配置下签发 IP 证书（约 6 天有效期，Caddy 自动续期）。
# 验证走 80 端口（HTTP-01），所以 80 必须对公网开放。
# 申请失败时 Caddy 会持续重试；如需临时回到自签名证书，把下面的 tls 块换成：
#   tls /certs/server.crt /certs/server.key
{$PUBLIC_HOST}:{$HTTPS_PORT} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	encode gzip
	request_body {
		max_size 60MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
	}
}

# 80 端口：ACME 验证由 Caddy 自动处理，其余请求跳转到 HTTPS 端口
http://{$PUBLIC_HOST} {
	redir https://{$PUBLIC_HOST}:{$HTTPS_PORT}{uri} permanent
}
