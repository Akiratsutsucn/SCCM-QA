{
	admin off
	# 标准 443 对外；14443 作为备用端口保留
	http_port 80
	default_sni {$PUBLIC_DOMAIN}
}

(app) {
	encode gzip
	request_body {
		max_size 60MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		# 必须带端口：Next.js Server Actions 用它和浏览器的 Origin 比对，防跨站提交
		header_up X-Forwarded-Host {hostport}
	}
}

# 主域名：标准 443（微信 / Tabbit / 手机用这个）
{$PUBLIC_DOMAIN} {
	import app
}
# 主域名：备用端口 14443
{$PUBLIC_DOMAIN}:{$HTTPS_PORT} {
	import app
}

# IP 应急访问（Let's Encrypt shortlived IP 证书）
{$PUBLIC_HOST}:{$HTTPS_PORT} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	import app
}

# 80 一律跳转到域名
http://{$PUBLIC_HOST}, http://{$PUBLIC_DOMAIN} {
	redir https://{$PUBLIC_DOMAIN}{uri} permanent
}
