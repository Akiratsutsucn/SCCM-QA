# 复制为 deploy/.env 后填写。.env 不入仓库。口令请用随机生成的长串（install.sh 会自动生成）。
PUBLIC_HOST=
HTTPS_PORT=14443
# 主域名：真实域名（A 记录指向服务器 IP，关闭 Cloudflare 代理）；微信/手机访问必须用它
PUBLIC_DOMAIN=
# 浏览器访问地址，用于匿名接口的 Origin 校验，例如 https://<公网IP>:14443
PUBLIC_ORIGIN=
POSTGRES_PASSWORD=
SESSION_HASH_SECRET=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
